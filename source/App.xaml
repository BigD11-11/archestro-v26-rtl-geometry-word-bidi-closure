    <SolidColorBrush x:Key="MutedBrush" Color="#8FA2BB"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#31C874"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF6268"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F20B1626"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF08111F"/>
