<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Archestro.MeetingVault</AssemblyName>
    <RootNamespace>Archestro.MeetingVault</RootNamespace>
    <ApplicationIcon>Assets\ArchestroMeetingVaultIcon.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0.0</FileVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <InternalBuild Condition="'$(InternalBuild)' == ''">V28R3</InternalBuild>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)+$(InternalBuild)</InformationalVersion>
    <Company>Archestro</Company>
    <Product>Archestro Meeting Vault</Product>
    <Authors>Archestro</Authors>
    <Description>Private offline meeting intelligence for Arabic and English.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CustomerVersion" Value="$(Version)" />
    <AssemblyMetadata Include="InternalBuild" Value="$(InternalBuild)" />
    <AssemblyMetadata Include="SourceCommit" Value="$(SourceCommit)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ArchestroMeetingVaultIcon.png" />
    <Resource Include="Assets\ArchestroLogoFull.png" />
    <Resource Include="Assets\ArchestroSymbol.png" />
    <Resource Include="Assets\ArchestroWatermark.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="brand.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
