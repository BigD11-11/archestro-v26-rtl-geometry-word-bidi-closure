<Window x:Class="Archestro.MeetingVault.Dialogs.SpeakerTranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Speaker Intelligence"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>

    <!-- V13.8.9 FINAL: theme-safe scrollbars; no native white fallback. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SpeakerButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SpeakerPrimaryButton" TargetType="Button" BasedOn="{StaticResource SpeakerButton}">
      <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}"/>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThemedProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryActionBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="3"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
      <Grid Margin="14,0,8,0">
        <TextBlock x:Name="ChromeTitleText"
                   Text="Speaker Intelligence"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource SpeakerButton}" Content="—" Width="38" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="Minimize" Click="ChromeMinimize_Click"/>
          <Button Style="{StaticResource SpeakerButton}" Content="✕" Width="38" Height="28" Padding="0" ToolTip="Close" Click="ChromeClose_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14"
            Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="MeetingTitleText" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="SummaryText"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AnalyzeButton"
                  Style="{StaticResource SpeakerPrimaryButton}"
                  Content="↻ Analyze / Refresh"
                  Click="Analyze_Click"/>
          <Button Style="{StaticResource SpeakerButton}"
                  Content="People"
                  Click="OpenPeople_Click"/>
          <Button Style="{StaticResource SpeakerButton}"
                  Content="Open original transcript"
                  Click="OpenOriginal_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14"
            Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="SpeakerChipsPanel"/>

        <Border Grid.Row="1"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="10,7"
                Margin="0,10,0,0">
          <TextBlock x:Name="StatusText"
                     Foreground="{DynamicResource AccentTextBrush}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"/>
        </Border>

        <ProgressBar x:Name="SpeakerProgressBar"
                     Grid.Row="2"
                     Style="{StaticResource ThemedProgress}"
                     Minimum="0" Maximum="100"
                     Value="0"
                     Visibility="Collapsed"
                     Margin="0,9,0,0"/>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10">
      <Grid>
        <TextBlock x:Name="EmptyStateText"
                   Text="No speaker analysis yet."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
        <ListBox x:Name="TranscriptList"
                 Background="Transparent"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding SpeakerName}" FontWeight="SemiBold"
                               Foreground="{Binding SpeakerColor}"/>
                    <TextBlock Text="{Binding TimeText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10" Margin="0,4,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Text}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             TextWrapping="Wrap"
                             Margin="10,0,15,0" FontSize="12.5" LineHeight="19"/>
                  <Button Grid.Column="2"
                          Style="{StaticResource SpeakerButton}"
                          Content="▶ Play" Tag="{Binding StartSeconds}"
                          Click="PlayLine_Click"
                          VerticalAlignment="Top"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14"
            Padding="12" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Give a speaker a name, then Remember Voice to help Archestro recognize the same person in future meetings."
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="VoiceProfileInfoText"
                     Text="Voice profiles stay local on this Windows account."
                     Foreground="{DynamicResource AccentTextBrush}"
                     FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="RejectMatchButton" Style="{StaticResource SpeakerButton}" Content="Not this person" Click="RejectMatch_Click"/>
          <Button x:Name="NewPersonButton" Style="{StaticResource SpeakerPrimaryButton}" Content="New person" Click="NewPerson_Click"/>
          <Button x:Name="RenameSpeakerButton" Style="{StaticResource SpeakerButton}" Content="Rename Speaker" Click="RenameSpeaker_Click"/>
          <Button x:Name="RememberVoiceButton" Style="{StaticResource SpeakerPrimaryButton}" Content="Remember Voice" Click="RememberVoice_Click"/>
          <Button Style="{StaticResource SpeakerButton}" Content="Stop Audio" Click="StopAudio_Click"/>
        </WrapPanel>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
