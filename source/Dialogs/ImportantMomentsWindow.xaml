<Window x:Class="Archestro.MeetingVault.Dialogs.ImportantMomentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="460"
        MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Title="Important Moments">
  <Window.Resources>

    <!-- V13.8.9 FINAL: theme-safe scrollbars; no native white fallback. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
      <Grid Margin="12,0,7,0">
        <TextBlock x:Name="ChromeTitleText" Text="Important Moments" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="—" Width="38" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="Minimize" Click="ChromeMinimize_Click"/>
          <Button Content="□" Width="38" Height="28" Padding="0" Margin="0,0,6,0" ToolTip="Maximize / Restore" Click="ChromeMaximize_Click"/>
          <Button Content="✕" Width="38" Height="28" Padding="0" ToolTip="Close" Click="ChromeClose_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
          CornerRadius="18" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Important Moments" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="MeetingTitleText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>

      <Border Grid.Row="1" Margin="0,14,0,12" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12,9">
        <TextBlock Text="Each mark is linked to the transcribed phrase spoken at that moment. The same marker is placed beside that phrase in the transcript."
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="10.5"/>
      </Border>

      <ListBox x:Name="MomentsList" Grid.Row="2"
               Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="17" Background="#3A1719"
                        BorderBrush="#9A4246" BorderThickness="1">
                  <TextBlock Text="●" Foreground="#FF5F57" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Timestamp}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                  <TextBlock Text="{Binding Context}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="340"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Copy time"
                        Tag="{Binding Timestamp}" Click="CopyTime_Click"
                        VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CountText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10.5"/>
        <Button Grid.Column="1" Content="Open Recording" Margin="0,0,9,0" Click="OpenRecording_Click"/>
        <Button Grid.Column="2" Content="Close" Width="82" Click="Close_Click"/>
      </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
